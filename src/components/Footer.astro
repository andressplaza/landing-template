---
interface Props {
  siteName: string;
  footerText?: string;
}
const { siteName, footerText } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-5 py-10 text-sm text-muted">
    <p class="font-semibold text-text">{siteName}</p>
    {footerText && <p class="mt-1">{footerText}</p>}
    <p class="mt-4">© {year} {siteName}. Todos los derechos reservados.</p>
  </div>
</footer>
