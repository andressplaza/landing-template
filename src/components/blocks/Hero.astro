---
import Button from '../Button.astro';

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  image?: string | null;
  imageAlt?: string;
}
const {
  id,
  eyebrow,
  title,
  subtitle,
  ctaLabel,
  ctaHref = '#',
  secondaryLabel,
  secondaryHref = '#',
  image,
  imageAlt = '',
} = Astro.props;
---

<section id={id} class="bg-bg">
  <div
    class={`mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 md:py-24 ${image ? 'md:grid-cols-2' : ''}`}
  >
    <div class={image ? '' : 'mx-auto max-w-3xl text-center'}>
      {eyebrow && (
        <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-accent">{eyebrow}</p>
      )}
      <h1 class="text-4xl leading-tight md:text-5xl">{title}</h1>
      {subtitle && <p class="mt-5 text-lg leading-relaxed text-muted">{subtitle}</p>}
      <div class={`mt-8 flex flex-wrap gap-3 ${image ? '' : 'justify-center'}`}>
        {ctaLabel && <Button href={ctaHref}>{ctaLabel}</Button>}
        {secondaryLabel && (
          <Button href={secondaryHref} variant="secondary">{secondaryLabel}</Button>
        )}
      </div>
    </div>
    {image && (
      <img
        src={image}
        alt={imageAlt}
        width="640"
        height="480"
        class="aspect-[4/3] w-full rounded-brand object-cover shadow-lg"
        fetchpriority="high"
      />
    )}
  </div>
</section>
