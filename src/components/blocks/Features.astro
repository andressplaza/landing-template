---
interface Item {
  icon?: string;
  title: string;
  text: string;
}
interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  items: Item[];
}
const { id, title, subtitle, items = [] } = Astro.props;
---

<section id={id} class="bg-surface">
  <div class="mx-auto max-w-6xl px-5 py-16 md:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl md:text-4xl">{title}</h2>
      {subtitle && <p class="mt-4 text-lg text-muted">{subtitle}</p>}
    </div>
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <li class="rounded-brand border border-border bg-bg p-6">
          {item.icon && <div class="text-3xl" aria-hidden="true">{item.icon}</div>}
          <h3 class="mt-3 text-xl">{item.title}</h3>
          <p class="mt-2 leading-relaxed text-muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
