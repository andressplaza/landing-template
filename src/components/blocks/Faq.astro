---
interface Item {
  question: string;
  answer: string;
}
interface Props {
  id?: string;
  title: string;
  items: Item[];
}
const { id, title, items = [] } = Astro.props;
---

<section id={id} class="bg-bg">
  <div class="mx-auto max-w-3xl px-5 py-16 md:py-20">
    <h2 class="text-center text-3xl md:text-4xl">{title}</h2>
    <div class="mt-10 divide-y divide-border rounded-brand border border-border">
      {items.map((item) => (
        <details class="group p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
            {item.question}
            <span class="text-accent transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 leading-relaxed text-muted">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
