---
interface Item {
  quote: string;
  name: string;
  role?: string;
}
interface Props {
  id?: string;
  title: string;
  items: Item[];
}
const { id, title, items = [] } = Astro.props;
---

<section id={id} class="bg-bg">
  <div class="mx-auto max-w-6xl px-5 py-16 md:py-20">
    <h2 class="mx-auto max-w-2xl text-center text-3xl md:text-4xl">{title}</h2>
    <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <li>
          <figure class="h-full rounded-brand border border-border bg-surface p-6">
            <blockquote class="leading-relaxed">“{item.quote}”</blockquote>
            <figcaption class="mt-5 text-sm">
              <span class="font-semibold">{item.name}</span>
              {item.role && <span class="text-muted"> · {item.role}</span>}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
