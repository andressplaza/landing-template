---
import Button from './Button.astro';

interface Props {
  siteName: string;
  links: { href: string; label: string }[];
  ctaLabel?: string;
  ctaHref?: string;
}
const { siteName, links, ctaLabel, ctaHref = '#' } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5">
    <a href="#" class="font-heading text-lg font-bold tracking-tight">{siteName}</a>
    <nav aria-label="Principal" class="hidden items-center gap-6 text-sm text-muted md:flex">
      {links.map((l) => <a href={l.href} class="hover:text-text">{l.label}</a>)}
    </nav>
    {ctaLabel && <Button href={ctaHref} class="!px-4 !py-2 text-sm">{ctaLabel}</Button>}
  </div>
</header>
